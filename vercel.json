{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/analyze", "destination": "/api/analyze" },
    { "source": "/qr", "destination": "/api/qr" },
    { "source": "/api/phone-sync", "destination": "/api/phone-sync" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.vercel.app http://localhost:5177 http://127.0.0.1:5177; connect-src 'self' https://*.vercel.app https://fyp-web-code-deployment.vercel.app"
        }
      ]
    }
  ]
}
